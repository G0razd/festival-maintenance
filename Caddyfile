{
	admin off
	servers {
		protocols h1 h2
	}
	on_demand_tls {
		ask http://127.0.0.1:9180/allow
	}
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
}

(page-headers) {
	header {
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
}

(page) {
	import page-headers
	root * /srv
	@document not path /_status/app.js
	rewrite @document /index.html
	file_server
}

(outage) {
	import page-headers
	root * /srv
	rewrite * /index.html
	file_server {
		status 503
	}
}

(probe) {
	reverse_proxy {$PROBE_UPSTREAM:status-probe:8080}
}

(status) {
	handle /_status/status.json {
		import probe
	}
	handle /_status/app.js {
		import page
	}
}

(maintenance) {
	encode zstd gzip
	import status

	handle /archiv* {
		reverse_proxy https://archiv.deckhand.lemmaweb.com {
			header_up Host archiv.deckhand.lemmaweb.com
		}
	}

	handle {
		import page
	}

	handle_errors {
		import page
	}
}

(site) {
	import status

	handle {
		reverse_proxy {$SITE_UPSTREAM:https://festival-26.deckhand.lemmaweb.com} {
			header_up Host {http.reverse_proxy.upstream.host}

			@unavailable status 502 503 504
			handle_response @unavailable {
				import outage
			}

			@unrouted {
				status 404
				header Content-Type text/plain*
				header Content-Length 19
			}
			handle_response @unrouted {
				import outage
			}
		}
	}

	handle_errors 502 503 504 {
		import outage
	}
}

http://:9180 {
	bind 127.0.0.1
	@allowed query domain=festival.fi.muni.cz domain=www.festival.fi.muni.cz
	respond @allowed 200
	respond 404
}

https://festival.fi.muni.cz, https://www.festival.fi.muni.cz {
	tls {
		on_demand
	}
	import {$FRONT_MODE:maintenance}
}

http://festival.fi.muni.cz, http://www.festival.fi.muni.cz {
	redir https://{host}{uri} 308
}

http://{$STATUS_HOST:status.deckhand.lemmaweb.com} {
	handle /hooks/* {
		import probe
	}
	import maintenance
}

http:// {
	import maintenance
}
