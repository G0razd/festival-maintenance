{
	admin off
	servers {
		protocols h1 h2
	}
	on_demand_tls {
		ask http://127.0.0.1:9180/allow
	}
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
}

(page) {
	header {
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	root * /srv
	rewrite * /index.html
	file_server
}

(maintenance) {
	encode zstd gzip

	handle /archiv* {
		reverse_proxy https://archiv.deckhand.lemmaweb.com {
			header_up Host archiv.deckhand.lemmaweb.com
		}
	}

	handle {
		import page
	}

	handle_errors {
		import page
	}
}

(site) {
	reverse_proxy {$SITE_UPSTREAM:https://festival-26.deckhand.lemmaweb.com} {
		header_up Host {http.reverse_proxy.upstream.host}
	}

	handle_errors 502 503 504 {
		import page
	}
}

http://:9180 {
	bind 127.0.0.1
	@allowed query domain=festival.fi.muni.cz domain=www.festival.fi.muni.cz
	respond @allowed 200
	respond 404
}

https://festival.fi.muni.cz, https://www.festival.fi.muni.cz {
	tls {
		on_demand
	}
	import {$FRONT_MODE:maintenance}
}

http://festival.fi.muni.cz, http://www.festival.fi.muni.cz {
	redir https://{host}{uri} 308
}

http:// {
	import maintenance
}
